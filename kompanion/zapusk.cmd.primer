@echo off
rem Запуск компаньона Jellyfin для Nokia E90.
rem
rem Этот файл -- единственное место, где задаются настройки: в исходниках
rem адресов и путей нет, всё читается отсюда. Службой оборачивается он же.

rem Пробные варианты из файлов-образцов не собирать: на машине с Jellyfin
rem этих файлов нет и быть не должно.
set PROBA_PRODUKT=1

rem Jellyfin на этой же машине, поэтому петля: запросы не выходят в сеть.
set PROBA_JELLYFIN=http://127.0.0.1:32400

rem Свой ffmpeg Jellyfin -- тот самый, которым он и перекодирует. Второй
rem ставить рядом незачем: это две разные версии на одной машине.
set PROBA_FFMPEG=C:\Program Files\Jellyfin\Server\ffmpeg.exe
set PROBA_FFPROBE=C:\Program Files\Jellyfin\Server\ffprobe.exe

rem Файл с одной строкой: TOKEN=<токен пользователя e90>. Не админский --
rem компаньону нужно ровно одно право: читать поток записи.
set PROBA_TOKEN_FILE=%~dp0token.txt

rem Куда писать журналы. Папке нужно право на запись у учётки службы.
set PROBA_ZHURNALY=%~dp0zhurnaly

rem Разговор RTSP и поток. Эти же числа должны стоять в правилах роутера.
rem
rem Порт НЕ 554 нарочно. На домашних роутерах там сидит встроенный помощник
rem RTSP: он перехватывает всё, что ведёт на внутренний 554, и проброс просто
rem не доходит -- снаружи порт ведёт себя как закрытый, хотя правило в
rem таблице есть. Проверено на Redmi: 554 и 5554 (разные внешние порты, один
rem внутренний) мертвы оба, 8554 работает.
set PROBA_PORT=8554
set PROBA_PORTS_FROM=40000
set PROBA_PORTS_TO=40063

rem Предел размера пакета видео в байтах. 1100 даёт IP-пакет 1128 байт --
rem проходит целым в мобильной сети, где предел обычно 1400--1430.
rem
rem Без этого ffmpeg набивает пакет до 1472 байт, то есть ровно до предела
rem обычной сети (1500 с заголовками). Дома это незаметно, а через мобильный
rem интернет каждый такой пакет дробится на два, и потеря любого куска губит
rem весь пакет -- картинка сыпется до следующего опорного кадра. Звук этим не
rem страдал никогда: у него пакет 400 байт.
rem
rem Уменьшать, если канал ещё уже (туннель поверх туннеля). Ноль -- отдать на
rem усмотрение ffmpeg, то есть вернуть прежнюю беду.
set PROBA_VIDEO_PKT=1100

rem Заполнять ли экран телефона целиком. Экран E90 внутри -- 800x352 (2.27:1),
rem а почти весь сериальный контент снят 16:9: целый кадр упирается в высоту и
rem оставляет 22% экрана чёрным по бокам. При заполнении кадр увеличивается до
rem покрытия экрана, лишнее срезается -- пропорции при этом не меняются.
rem
rem Ноль -- целый кадр с полями по бокам. Так и оставлено: владелец
rem посмотрел оба варианта живьём и выбрал целый кадр, потому что при
rem заполнении у сериала 16:9 срезается 22% высоты.
set PROBA_ZAPOLNIT=0

rem Экран телефона по умолчанию. Обычно трогать не нужно: приложение само
rem называет свой экран при каждом запуске, и один компаньон спокойно
rem обслуживает и E90 с его 800x352, и обычный телефон с 320x240.
rem
rem Это значение берётся только для плеера, пришедшего по голому адресу,
rem без приложения -- и для старых сборок приложения, которые экран ещё не
rem называли. У нас такой телефон один, и он E90.
set PROBA_EKRAN=800x352

rem Требовать токен Jellyfin ОТ ВСЕХ, без поблажки домашней сети.
rem Включить, когда на телефоне окажется 0.1.4 или новее: сборки до неё
rem токен в адрес не кладут и перестанут играть.
rem set PROBA_STROGO=1

if not exist "%PROBA_ZHURNALY%" mkdir "%PROBA_ZHURNALY%"

"C:\Tools\ClaudeTools\python\python.exe" "%~dp0rtsp-proba.py"
